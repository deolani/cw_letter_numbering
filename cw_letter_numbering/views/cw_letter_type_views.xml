<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cw_letter_type_tree" model="ir.ui.view">
        <field name="name">cw.letter.type.tree</field>
        <field name="model">cw.letter.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_cw_letter_type_form" model="ir.ui.view">
        <field name="name">cw.letter.type.form</field>
        <field name="model">cw.letter.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cw_letter_type" model="ir.actions.act_window">
        <field name="name">Letter Types</field>
        <field name="res_model">cw.letter.type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
